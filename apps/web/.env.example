# =============================================================================
# Provider Toggles (pilih sumber data + LLM)
# =============================================================================

# Data source: etherscan | rpc
#   - etherscan: butuh ETHERSCAN_API_KEY, full tx history (native + ERC-20)
#   - rpc: tanpa API key, pakai public JSON-RPC, ERC-20 only (limitasi protokol)
DATA_PROVIDER=etherscan

# LLM provider: claude | ollama
#   - claude: hosted, butuh ANTHROPIC_API_KEY
#   - ollama: lokal, butuh Ollama running di OLLAMA_BASE_URL
LLM_PROVIDER=claude

# =============================================================================
# Etherscan V2 (DATA_PROVIDER=etherscan)
# =============================================================================
# https://etherscan.io/myapikey — gratis, satu key untuk 50+ chain via V2
ETHERSCAN_API_KEY=

# =============================================================================
# Direct JSON-RPC (DATA_PROVIDER=rpc)
# =============================================================================
# Comma-separated daftar URL RPC publik per chain (auto-fallback jika error).
# Kosongkan untuk pakai default bawaan (llamarpc, cloudflare, drpc, dll).
RPC_URLS_1=
RPC_URLS_56=
RPC_URLS_137=

# Berapa blok terakhir yang di-scan untuk eth_getLogs (max 100000)
# Default 10000 ≈ ~1.5 hari di ETH mainnet.
RPC_LOG_BLOCK_RANGE=10000

# =============================================================================
# Anthropic Claude (LLM_PROVIDER=claude)
# =============================================================================
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# =============================================================================
# Ollama (LLM_PROVIDER=ollama)
# =============================================================================
# Pastikan Ollama running: `ollama serve` atau `docker compose up ollama`
# Pull model dulu: `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# =============================================================================
# Storage & cache
# =============================================================================
SQLITE_PATH=./data/chainnusa.db
CACHE_TTL_SECONDS=3600
