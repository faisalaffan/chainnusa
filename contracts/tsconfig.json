{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["./hardhat.config.ts", "./script/**/*.ts", "./test/**/*.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "cache-hardhat"]
}
