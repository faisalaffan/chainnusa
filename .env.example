# Etherscan V2 Multichain API — satu API key untuk semua chain
# Dapatkan di https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Anthropic Claude API key
# Dapatkan di https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Claude (default: claude-3-5-sonnet-latest)
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Path SQLite DB (default: ./data/chainnusa.db)
SQLITE_PATH=./data/chainnusa.db

# Cache TTL per wallet scan, dalam detik (default: 3600 = 1 jam)
CACHE_TTL_SECONDS=3600
